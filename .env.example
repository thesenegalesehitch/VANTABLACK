# VANTABLACK Environment Variables
# =================================
# Copy this file to .env and fill in the values.
# Never commit the .env file to version control.

# PostgreSQL Database Settings
POSTGRES_DB=vantablack
POSTGRES_USER=vantablack
# It is strongly recommended to use a long, random string for the password.
POSTGRES_PASSWORD=changeme

# Grafana Monitoring Settings
GRAFANA_ADMIN_PASSWORD=changeme
